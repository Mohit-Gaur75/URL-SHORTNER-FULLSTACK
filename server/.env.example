NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/url-shortener
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=paste_a_long_random_string_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Cookies: lax is right when the app and the API share a site (e.g. localhost, or
# app.example.com + api.example.com). If they are on unrelated domains you need
# COOKIE_SAMESITE=none, which requires HTTPS (COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# How many reverse proxies are in front of the server. 0 = none (local development).
# On Render, set 1. Wrong values break per-IP rate limits (see config/env.js).
TRUST_PROXY=0
# DEVELOPMENT ONLY: multiplies every rate limit (10 = ten times more generous).
# RATE_LIMIT_MULTIPLIER=10

